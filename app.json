{
  "expo": {
    "name": "My Quick Trippers",
    "slug": "mqt-app",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon-v2.png",
      "backgroundColor": "#127C82"
    },
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSFaceIDUsageDescription": "Unlock the app with your fingerprint or face."
      }
    },
    "android": {
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#127C82",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mqtapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "61ca1513-a157-469d-913e-e6db82aa9caa"
      }
    },
    "owner": "myquicktrippers-team",
    "plugins": [
      "expo-image",
      "expo-notifications",
      "expo-splash-screen"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/61ca1513-a157-469d-913e-e6db82aa9caa"
    }
  }
}
